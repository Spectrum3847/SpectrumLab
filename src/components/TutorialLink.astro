---
/**
 * Clean card linking to external documentation, manuals, and tutorials.
 * <TutorialLink title="WAZER Pro User Manual" url="..." source="pdf" description="Official manual downloads" />
 * Sources: pdf, manual, youtube, website, forum, knowledge-base
 */
interface Props {
  title: string;
  url: string;
  source?: 'pdf' | 'manual' | 'youtube' | 'website' | 'forum' | 'knowledge-base';
  description?: string;
}
const { title, url, source = 'website', description } = Astro.props;

const icons: Record<string, { icon: string; label: string }> = {
  pdf: { icon: '📄', label: 'PDF' },
  manual: { icon: '📖', label: 'Manual' },
  youtube: { icon: '▶️', label: 'Video' },
  website: { icon: '🌐', label: 'Website' },
  forum: { icon: '💬', label: 'Forum' },
  'knowledge-base': { icon: '📚', label: 'Docs' },
};
const meta = icons[source] ?? icons.website;
---

<a class="tutorial-link" href={url} target="_blank" rel="noopener noreferrer">
  <span class="tl-icon" aria-hidden="true">{meta.icon}</span>
  <span class="tl-text">
    <span class="tl-title">{title}</span>
    {description && <span class="tl-desc">{description}</span>}
  </span>
  <span class="tl-badge">{meta.label} ↗</span>
</a>

<style>
  .tutorial-link {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin: 0.6rem 0;
    padding: 0.8rem 1rem;
    border: 1px solid var(--sl-color-border);
    border-radius: 0.7rem;
    background: var(--sl-color-bg);
    text-decoration: none !important;
    border-bottom: 1px solid var(--sl-color-border) !important;
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  .tutorial-link:hover {
    border-color: var(--sl-color-accent) !important;
    box-shadow: 0 6px 18px rgba(107, 17, 153, 0.12);
    transform: translateY(-1px);
  }
  .tl-icon { font-size: 1.35rem; line-height: 1; flex-shrink: 0; }
  .tl-text { display: flex; flex-direction: column; min-width: 0; flex: 1 1 auto; }
  .tl-title {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--sl-color-text);
    line-height: 1.3;
  }
  .tl-desc {
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
    line-height: 1.4;
    margin-top: 0.1rem;
  }
  .tl-badge {
    flex-shrink: 0;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
    border-radius: 9999px;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
  }
</style>
